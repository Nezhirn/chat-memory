# Database (required). Use 127.0.0.1:5432 on the host or db:5432 inside compose.
DATABASE_URL=postgresql://chat_memory:change-me@127.0.0.1:5432/chat_memory
DB_PASSWORD=change-me
DB_SCHEMA=rag_demo
DB_POOL_MIN=1
DB_POOL_MAX=10
HNSW_EF_SEARCH=100

# Read-only source for the demo import (ai_base, schema market_research).
SOURCE_DATABASE_URL=postgresql://agent:change-me@127.0.0.1:5432/ai_base

# PDF OCR and embeddings.
OCR_CACHE_DIR=data/cache/ocr
OCR_PROVIDER=tesseract
OCR_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
EMBEDDING_CACHE_DIR=data/cache/fastembed
EMBEDDING_THREADS=3
EMBEDDING_DIM=256

# OpenRouter and models.
OPENROUTER_API_KEY=
AGENT_MODEL=google/gemini-2.5-flash
JUDGE_MODEL=openai/gpt-4.1-mini

# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
# Optional HTTP proxy for Bot API, e.g. http://127.0.0.1:8118
TELEGRAM_PROXY=

# Local API admin token.
ADMIN_TOKEN=
# Public base URL for clickable PDF links in Telegram, e.g. https://memory.example.com
PUBLIC_BASE_URL=
